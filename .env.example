# Kemal Oto Örnek Ortam Değişkenleri
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 1. Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. İyzico
IYZICO_API_KEY=your-iyzico-api-key
IYZICO_SECRET_KEY=your-iyzico-secret-key
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# 3. Resend Mail
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Kemal Oto <bilgi@kemaloto.com>
ADMIN_NOTIFICATION_EMAIL=bilgi@kemaloto.com

# 4. Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret

# 5. DHL Kargo
DHL_CLIENT_ID=your-dhl-client-id
DHL_CLIENT_SECRET=your-dhl-client-secret
DHL_ACCOUNT_NUMBER=your-dhl-account-number
DHL_API_URL=https://express.api.dhl.com/mydhlapi/test
DHL_IS_SANDBOX=true
